{
  "name": "pi-oauth",
  "version": "0.1.0",
  "packageManager": "yarn@4.13.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaiiy/pi-oauth.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
